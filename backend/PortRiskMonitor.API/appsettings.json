{
  // ============================================================
  // APPSETTINGS.JSON — Application configuration
  //
  // Key sections:
  //   ConnectionStrings  — database location
  //   Auditing           — toggle audit logging without recompile (NFR: Interceptors)
  //   RiskScoring        — swap risk algorithm without recompile (NFR: Extensibility)
  //   MockData           — control the background data generator
  //   Serilog            — structured logging configuration
  // ============================================================

  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=portrisks;Username=portuser;Password=portpass"
  },

  "Auditing": {
    // NFR: Cross-cutting / Interceptors
    // Set to false to disable all business logic audit logging
    // WITHOUT modifying or recompiling any business logic code.
    // This satisfies the "enable/disable without recompile" requirement.
    "Enabled": true
  },

  "RiskScoring": {
    // NFR: Extensibility / Strategy Pattern
    // Change this value to swap the risk calculation algorithm at runtime.
    // Available values:
    //   "DefaultWeighted" — weighted sum of KRI scores (default)
    //   "MaxRisk"         — uses the single worst KRI score as the composite
    //   "AverageRisk"     — simple arithmetic mean of all KRI scores
    // To add a new strategy: create a new class implementing IRiskScoreStrategy,
    // add a case in Program.cs, then change this string — no other code changes needed.
    "Strategy": "DefaultWeighted"
  },

  "MockData": {
    // Controls the MockDataBackgroundService (NFR: Async / BackgroundService)
    // TODO: Set Enabled=false when real data sources are connected
    "Enabled": true,
    "IntervalSeconds": 30,           // How often to generate new KRI readings
    "SeedOnStartup": true,           // Insert default KRI definitions if DB is empty
    "DefaultScenario": "Normal"      // Starting scenario: Normal | MildCongestion | StormEvent | CustomsCrisis | FullRedAlert
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      // TODO: Set EF Core to "Information" temporarily to see generated SQL during development
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
