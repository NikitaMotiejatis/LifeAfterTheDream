{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=port_risk_monitor.db"
  },

  // NFR: Cross-cutting / Interceptors — toggle audit logging without recompile
  "Auditing": {
    "Enabled": true
  },

  // NFR: Extensibility / Strategy — swap risk calculation algorithm via config
  "RiskScoring": {
    "Strategy": "DefaultWeighted"
  },

  "Alerts": {
    "Sms": {
      "Enabled": false,
      "AwsRegion": "us-east-1",
      "RecipientPhoneNumbers": []
    }
  },

  "MockData": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "SeedOnStartup": true,
    "DefaultScenario": "Normal"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
