{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=portrisks;Username=portuser;Password=portpass"
  },

  // NFR: Cross-cutting / Interceptors — toggle audit logging without recompile
  "Auditing": {
    "Enabled": true
  },

  // NFR: Extensibility / Strategy — swap risk calculation algorithm via config
  "RiskScoring": {
    "Strategy": "DefaultWeighted"
  },

  // NFR: Extensibility / Strategy + Decorator — hot-swappable notification pipeline.
  // Options for Channel: "Off" | "Twilio" | "Email".
  "Notifications": {
    "Channel": "Off",
    "Decorators": [ "Retry" ],
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": "",
      "ToNumbers": []
    },
    "Email": {
      "SmtpHost": "smtp.gmail.com",
      "SmtpPort": 587,
      "UseStartTls": true,
      "FromAddress": "",
      "Username": "",
      "AppPassword": "",
      "ToAddresses": []
    }
  },

  "MockData": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "SeedOnStartup": true,
    "DefaultScenario": "Normal"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
